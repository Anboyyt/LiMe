# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会进仓库。

# ---- TMDB 刮削（留空则关闭）----
LIME_TMDB_API_KEY=
# 访问 TMDB 的 HTTP 代理（国内需要），容器内不能用 127.0.0.1
LIME_TMDB_PROXY=

# ---- Telegram 播放通知（留空则关闭）----
LIME_TG_BOT_TOKEN=
LIME_TG_CHAT_ID=
LIME_TG_PROXY=

# ---- STRM 地址改写（外网访问时需要）----
# STRM 里原始的 PanSave 地址
LIME_REWRITE_FROM=
# 局域网客户端使用的地址
LIME_REWRITE_LOCAL=
# 外网客户端使用的地址
LIME_REWRITE_PUBLIC=

# ---- PanSave 反代探测（只暴露反代端口时填）----
# 必须是 PanSave 能直接访问的 LiMe 上游地址
LIME_INTERNAL_URL=

# ---- 客户端下载 / 离线缓存 ----
# redirect: 302 到 CDN（默认，不占 NAS 带宽）；proxy: LiMe 中转（占上行）；
# off: 关闭下载入口。客户端不跟 302 时再改 proxy。
# LIME_DOWNLOAD_MODE=redirect

# ---- SQLite 内存（一般不用改）----
# 每个连接的页缓存 MB，8 个连接合计上限约为 8 倍；默认 32
# LIME_SQLITE_CACHE_MB=32
# mmap 大小 MB，0 关闭；默认 256
# LIME_SQLITE_MMAP_MB=256
