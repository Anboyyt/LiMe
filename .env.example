# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会进仓库。

# ---- TMDB 刮削（留空则关闭）----
LIME_TMDB_API_KEY=
# 访问 TMDB 的 HTTP 代理（国内需要），容器内不能用 127.0.0.1
LIME_TMDB_PROXY=

# ---- Telegram 播放通知（留空则关闭）----
LIME_TG_BOT_TOKEN=
LIME_TG_CHAT_ID=
LIME_TG_PROXY=

# ---- STRM 地址改写（外网访问时需要）----
# STRM 里原始的 PanSave 地址
LIME_REWRITE_FROM=
# 局域网客户端使用的地址
LIME_REWRITE_LOCAL=
# 外网客户端使用的地址
LIME_REWRITE_PUBLIC=

# ---- PanSave 反代探测（只暴露反代端口时填）----
# 必须是 PanSave 能直接访问的 LiMe 上游地址
LIME_INTERNAL_URL=
